{
  "name": "modfield",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @modfield/web dev",
    "build": "pnpm --filter @modfield/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @modfield/web test:e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
